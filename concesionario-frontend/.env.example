# URL base para el consumo de la API REST
# En desarrollo local con Vite proxy, se utiliza '/api' para redirigir a http://localhost:5145
VITE_API_BASE_URL=/api

# Título de la aplicación
VITE_APP_TITLE=Sistema de Gestión - Concesionario

# Credenciales para pruebas End-to-End (Playwright)
# Configure un usuario con rol 'Admin' existente en la base de datos
TEST_USER_EMAIL=admin@gmail.com
TEST_USER_PASSWORD=tu_password_aqui
